# Copy this file to `.env` and fill in the values from:
# Firebase console -> Project settings (gear icon) -> Your apps -> Web app (</>)
#
# Expo only inlines env vars prefixed EXPO_PUBLIC_ into the client bundle.
# These are not secret the way a server API key is -- Firestore/Storage/Auth
# access is actually controlled by the security rules you deploy, not by
# hiding this config. Still, don't commit the filled-in `.env`.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From EAS: `eas project:info` or the Expo dashboard project URL.
# Needed to fetch a real Expo push token on-device.
EXPO_PUBLIC_EAS_PROJECT_ID=
